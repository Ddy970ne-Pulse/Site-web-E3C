# Copy to .env and fill in real values.

REACT_APP_BACKEND_URL=http://localhost:8000

# Google Sign-In (client-side, public — not a secret). Must match GOOGLE_CLIENT_ID
# in the backend .env. Leave unset to hide the Google button entirely.
REACT_APP_GOOGLE_CLIENT_ID=

# Facebook Login (client-side, public — not a secret). Must match FACEBOOK_APP_ID
# in the backend .env. Leave unset to hide the Facebook button entirely.
REACT_APP_FACEBOOK_APP_ID=

# Optional dev-server webpack health check plugin (see craco.config.js)
ENABLE_HEALTH_CHECK=false
