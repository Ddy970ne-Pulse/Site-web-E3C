# Copy to .env and fill in real values.

REACT_APP_BACKEND_URL=http://localhost:8000

# Google/Facebook/Apple sign-in buttons are NOT configured here. The frontend
# fetches which providers are enabled from GET /api/auth/providers at runtime,
# sourced from the backend's Admin > Paramètres settings (or its GOOGLE_CLIENT_ID/
# FACEBOOK_APP_ID/APPLE_CLIENT_ID env vars as a fallback). Configure them there —
# a value set only here would have no effect, since the buttons never read
# process.env directly.

# Optional dev-server webpack health check plugin (see craco.config.js)
ENABLE_HEALTH_CHECK=false
