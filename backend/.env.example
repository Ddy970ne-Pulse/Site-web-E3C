# Copy to .env and fill in real values. The app refuses to start if the
# required variables below are missing or too weak — see require_env() in server.py.

MONGO_URL=mongodb://localhost:27017
DB_NAME=e3c

# Required, no default. Minimum 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=

# Required, no default. Minimum 12 characters. Must not match any password ever
# committed to this repo's history.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@e3c-construction.com

# Stripe
STRIPE_API_KEY=
# Signing secret for the /api/webhook/stripe endpoint, from the Stripe dashboard.
# Webhooks are ignored (not trusted) if this is unset.
STRIPE_WEBHOOK_SECRET=

# Brevo transactional email (optional — emails are skipped and logged if unset)
BREVO_API_KEY=
SENDER_EMAIL=noreply@e3c-construction.com

FRONTEND_URL=http://localhost:3000

# Set to true once served over HTTPS in production (session cookies won't be
# sent over plain HTTP otherwise).
COOKIE_SECURE=false

# Google Sign-In (clients only — admins are rejected with 403). OAuth Client ID
# from Google Cloud Console. Must match REACT_APP_GOOGLE_CLIENT_ID in the frontend.
# /api/auth/google returns 503 while this is unset.
GOOGLE_CLIENT_ID=

# Facebook Login (clients only — admins are rejected with 403). From Facebook for
# Developers > your app > Settings > Basic. FACEBOOK_APP_ID must match
# REACT_APP_FACEBOOK_APP_ID in the frontend. /api/auth/facebook returns 503 while unset.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
